# ============================================================
# COPY this file to ".env.local" and fill in YOUR real values.
# In Vercel, add these same 3 as Environment Variables (Settings -> Environment Variables).
# ============================================================

# Supabase Project URL  (Supabase -> Settings -> API -> Project URL)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co

# Supabase ANON public key  (Supabase -> Settings -> API -> Project API keys -> anon public)
# SAFE to expose in the browser. NEVER put the service_role key here.
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGci...YOUR_ANON_KEY

# n8n Manual Search webhook URL (set AFTER you build Workflow 3; leave blank for now).
# When blank, off-universe live search is disabled gracefully; dashboard + cached search still work.
NEXT_PUBLIC_SEARCH_WEBHOOK_URL=
